{
  "name": "dsh-workspace-category",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group workspaces into categories, filter the sidebar by category, and assign a category from a workspace's menu.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/universe-st/dsh-workspace-category.git"
  },
  "homepage": "https://github.com/universe-st/dsh-workspace-category#readme",
  "bugs": {
    "url": "https://github.com/universe-st/dsh-workspace-category/issues"
  },
  "author": "universe-st",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workspace",
    "category",
    "sidebar",
    "filter"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
